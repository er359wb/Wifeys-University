ENTITY problem IS
PORT ( x1, x2, s: IN STD_LOGIC ;
y1, y2 : OUT STD_LOGIC) ;
END problem ;
ARCHITECTURE Behavior OF problem IS
BEGIN
PROCESS ( x1, x2, s )
BEGIN
IF s = ’0’ THEN
y1 <= x1 ;
y2 <= x2 ;
ELSIF s = ’1’ THEN
y1 <= x2 ;
END IF ;
END PROCESS ;
END Behavior ;
