RAdd : IN INTEGER RANGE 0 TO 3 ;
DataOut : BUFFER STD LOGIC VECTOR(N – 1 DOWNTO 0) ;
Done : BUFFER STD LOGIC ) ;
END sort ;
ARCHITECTURE Behavior OF sort IS
