X <= SW(7 DOWNTO 0) ;
Y <= SW(15 DOWNTO 8) ;
LEDR(7 DOWNTO 0) <=X;
LEDR(15 DOWNTO 8) <=Y;
adder_circuit: megadd PORT MAP ( cin => carryin, dataa => X,
datab => Y, result = S, cout => carryout ) ;
LEDG(7 DOWNTO 0) <= S;
LEDG(8) <= carryout;
END Structure ;
