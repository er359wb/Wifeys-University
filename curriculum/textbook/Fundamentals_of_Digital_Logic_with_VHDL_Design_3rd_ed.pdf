0 000 m0 = x1x2x3 M0 = x1 + x2 + x3
1 001 m1 = x1x2x3 M1 = x1 + x2 + x3
2 010 m2 = x1x2x3 M2 = x1 + x2 + x3
3 011 m3 = x1x2x3 M3 = x1 + x2 + x3
4 100 m4 = x1x2x3 M4 = x1 + x2 + x3
5 101 m5 = x1x2x3 M5 = x1 + x2 + x3
6 110 m6 = x1x2x3 M6 = x1 + x2 + x3
